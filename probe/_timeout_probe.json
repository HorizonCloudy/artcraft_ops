      "name": "artcraft_ops_run_sequence",
      "event_type": "plugin_entry",
      "kind": "action",
      "auto_start": false,
      "timeout": 30.0,
      "description": "当用户要在 ArtCraft 软件里执行一串编辑/导出命令时使用；秒回 job_id，用 get_job 查结果、cancel_job 取消",
      "input_schema": {
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "enum": [
              "photocraft",
              "vectorcraft",
              "craft_anything"
            ]
          },
          "steps": {
            "type": "array",
            "maxItems": 256,
            "description": "按序执行的命令；cmd 用引擎命令名（document.* 而非 doc.*）；params 依据 params_schema 填",
            "items": {
              "type": "object",
              "properties": {
                "cmd": {
                  "type": "string"
                },
                "params": {
                  "type": "object"
                }
              },
              "required": [
                "cmd"
              ]
            }
          },
          "input_file": {
            "type": "string",
            "description": "绝对路径；须在已授权 read root；与 new_doc 二选一"
          },
          "new_doc": {
            "type": "object",
            "description": "如 {width:640,height:400,background:'white'}"
          },
          "out_file": {
            "type": "string",
            "description": "输出文件名或绝对路径；写入 write root"
          },
          "inspect": {
            "type": "boolean",
            "description": "序列末尾自动追加 document.inspect，默认 true"
          }
        },
        "required": [
          "steps"
        ]
      },
      "llm_result_fields": [],
      "quick_action": false,
      "async": true,
      "interval_seconds": null
    },
