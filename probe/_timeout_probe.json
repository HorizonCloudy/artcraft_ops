      "kind": "action",
      "auto_start": false,
      "timeout": 20.0,
      "description": "当用户想对图片/矢量/文档执行某操作但不知道命令名时，先按关键词检索命令与人类可读参数 schema",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "自然语言或关键词，如 调亮 / sharpen / 新建图层；服务端按此过滤命令注册表"
